# 从本次构建实际发现的依赖目录收集许可；不下载依赖，也不改依赖安装目录。

# 参数为依赖的位置列表，返回这些位置及其父目录，供不同包管理器布局复用。
function(gamehub_license_roots output)
    set(roots)
    foreach(location IN LISTS ARGN)
        if(NOT IS_ABSOLUTE "${location}" OR NOT EXISTS "${location}")
            continue()
        endif()
        if(IS_DIRECTORY "${location}")
            set(parent "${location}")
        else()
            get_filename_component(parent "${location}" DIRECTORY)
        endif()
        foreach(level RANGE 0 3)
            list(APPEND roots "${parent}")
            get_filename_component(next "${parent}" DIRECTORY)
            if(next STREQUAL parent)
                break()
            endif()
            set(parent "${next}")
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES roots)
    set(${output} "${roots}" PARENT_SCOPE)
endfunction()

# 从选定依赖的安装前缀查找包管理器保留的许可，返回文件列表。
function(gamehub_find_package_licenses output)
    cmake_parse_arguments(ARG "" "" "ROOTS;PACKAGES;SOURCE_NAMES" ${ARGN})
    set(files)
    foreach(root IN LISTS ARG_ROOTS)
        foreach(package IN LISTS ARG_PACKAGES)
            file(GLOB candidates LIST_DIRECTORIES false
                "${root}/share/${package}/copyright"
                "${root}/share/licenses/${package}/*"
                "${root}/share/doc/${package}/copyright")
            list(APPEND files ${candidates})
        endforeach()
        # 源码发行包也可以直接提供 LICENSE、COPYING 等原始文件。
        foreach(name IN LISTS ARG_SOURCE_NAMES)
            if(EXISTS "${root}/${name}" AND NOT IS_DIRECTORY "${root}/${name}")
                list(APPEND files "${root}/${name}")
            endif()
        endforeach()
        if(files)
            break()
        endif()
    endforeach()
    list(REMOVE_DUPLICATES files)
    set(${output} "${files}" PARENT_SCOPE)
endfunction()

# 注册一个组件的全部许可文件；返回值通过全局属性传给安装清单。
function(gamehub_install_component_licenses component)
    string(TOUPPER "${component}" optionName)
    string(REPLACE "-" "_" optionName "${optionName}")
    set(optionName "GAMEHUB_LICENSE_${optionName}_FILES")
    set(${optionName} "" CACHE STRING "${component} 的实际许可文件列表（分号分隔，可覆盖自动查找）")
    if(${optionName})
        set(files "${${optionName}}")
    else()
        set(files "${ARGN}")
    endif()
    if(NOT files)
        message(FATAL_ERROR "缺少 ${component} 的许可文件，不能生成完整安装包。请通过 ${optionName} 指定与本次依赖版本对应的文件。")
    endif()
    set(seenFiles)
    set(index 0)
    foreach(source IN LISTS files)
        get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
            message(FATAL_ERROR "${component} 的许可文件不存在：${source}")
        endif()
        file(READ "${source}" content)
        string(STRIP "${content}" content)
        if(content STREQUAL "")
            message(FATAL_ERROR "${component} 的许可文件为空：${source}")
        endif()
        file(SHA256 "${source}" hash)
        get_filename_component(name "${source}" NAME)
        set(identity "${name}|${hash}")
        if(identity IN_LIST seenFiles)
            continue()
        endif()
        list(APPEND seenFiles "${identity}")
        math(EXPR index "${index} + 1")
        set(relative "${component}/${index}-${name}")
        install(FILES "${source}" DESTINATION "share/gamehub/licenses/${component}" RENAME "${index}-${name}")
        set_property(GLOBAL APPEND PROPERTY GAMEHUB_LICENSE_MANIFEST "${component}\t${relative}\t${hash}\n")
        set_property(GLOBAL APPEND PROPERTY GAMEHUB_LICENSE_RECORDS "${relative}|${hash}|${source}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    endforeach()
endfunction()

# 提取 bundled picohttpparser 源文件的完整首部声明，不改写版权和许可正文。
function(gamehub_pico_source_licenses output directory)
    set(files)
    foreach(name picohttpparser.c picohttpparser.h)
        set(source "${directory}/${name}")
        if(NOT EXISTS "${source}")
            set(${output} "" PARENT_SCOPE)
            return()
        endif()
        file(READ "${source}" content)
        string(FIND "${content}" "*/" end)
        if(NOT content MATCHES "^/\\*" OR end LESS 0)
            message(FATAL_ERROR "picohttpparser 的首部许可格式无法识别：${source}")
        endif()
        math(EXPR length "${end} + 2")
        string(SUBSTRING "${content}" 0 ${length} notice)
        if(NOT notice MATCHES "Copyright" OR NOT notice MATCHES "Permission is hereby granted")
            message(FATAL_ERROR "picohttpparser 的首部缺少完整许可：${source}")
        endif()
        set(destination "${CMAKE_BINARY_DIR}/gamehub-licenses/picohttpparser/${name}.LICENSE.txt")
        file(WRITE "${destination}" "${notice}\n")
        list(APPEND files "${destination}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    endforeach()
    set(${output} "${files}" PARENT_SCOPE)
endfunction()

# 注册默认 GameHub 依赖的许可；参数无，生成安装规则及清单，无返回值。
function(gamehub_install_licenses)
    gamehub_install_component_licenses(gamehub "${PROJECT_SOURCE_DIR}/LICENSE" "${PROJECT_SOURCE_DIR}/THIRD_PARTY_NOTICES.md")

    if(GAMEHUB_HICAL_SOURCE)
        # 使用应用补丁后的副本，确保许可来源与编译的源文件一致。
        set(hicalRoots "${gamehubHicalSource}")
        gamehub_find_package_licenses(hicalLicenses ROOTS ${hicalRoots} SOURCE_NAMES LICENSE LICENSE.txt COPYING)
    else()
        gamehub_license_roots(hicalRoots "${hical_DIR}")
        gamehub_find_package_licenses(hicalLicenses ROOTS ${hicalRoots} PACKAGES hical)
    endif()
    gamehub_install_component_licenses(hical ${hicalLicenses})

    gamehub_license_roots(boostRoots ${Boost_INCLUDE_DIRS} "${Boost_INCLUDE_DIR}" "${Boost_DIR}")
    gamehub_find_package_licenses(boostLicenses ROOTS ${boostRoots}
        PACKAGES boost "boost-*" "boost_*" boost-libs SOURCE_NAMES LICENSE_1_0.txt)
    gamehub_install_component_licenses(boost ${boostLicenses})

    gamehub_license_roots(opensslRoots "${OPENSSL_INCLUDE_DIR}" "${OPENSSL_CRYPTO_LIBRARY}")
    gamehub_find_package_licenses(opensslLicenses ROOTS ${opensslRoots}
        PACKAGES openssl)
    gamehub_install_component_licenses(openssl ${opensslLicenses})

    # find_package(hical) 内部发现的变量可能处于函数作用域，目标属性提供同一依赖的位置。
    if(TARGET ZLIB::ZLIB)
        get_target_property(zlibIncludes ZLIB::ZLIB INTERFACE_INCLUDE_DIRECTORIES)
    endif()
    gamehub_license_roots(zlibRoots ${zlibIncludes} "${ZLIB_INCLUDE_DIR}" "${ZLIB_LIBRARY_RELEASE}")
    gamehub_find_package_licenses(zlibLicenses ROOTS ${zlibRoots}
        PACKAGES zlib)
    gamehub_install_component_licenses(zlib ${zlibLicenses})

    if(GAMEHUB_LICENSE_PICOHTTPPARSER_FILES)
        set(picoLicenses "")
    elseif(GAMEHUB_HICAL_SOURCE AND NOT HICAL_USE_SYSTEM_PICOHTTPPARSER)
        gamehub_pico_source_licenses(picoLicenses "${gamehubHicalSource}/src/third_party/picohttpparser")
    else()
        gamehub_license_roots(picoRoots "${PICOHTTPPARSER_INCLUDE_DIR}" "${PICOHTTPPARSER_LIBRARY}" "${hical_DIR}")
        gamehub_find_package_licenses(picoLicenses ROOTS ${picoRoots} PACKAGES picohttpparser)
    endif()
    gamehub_install_component_licenses(picohttpparser ${picoLicenses})

    gamehub_install_runtime_licenses()
    gamehub_write_license_manifest()
endfunction()

# 安装编译器附带的运行库声明；参数无，返回值写入全局安装清单。
function(gamehub_install_runtime_licenses)
    if(MSVC AND CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS AND NOT CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS_SKIP)
        # 该原始 RTF 提取自 VS 2022 附带的 VC_redist，来源和摘要记在第三方说明中。
        # 其他工具集必须提供对应文件，不能把这一份自动用于未来版本。
        if(MSVC_TOOLSET_VERSION STREQUAL "143")
            set(msvcLicense "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/licenses/msvc-runtime-2015-2022.rtf")
        else()
            set(msvcLicense "")
        endif()
        gamehub_install_component_licenses(msvc-runtime ${msvcLicense})
    endif()
    if(MINGW)
        gamehub_license_roots(compilerRoots "${CMAKE_CXX_COMPILER}")
        gamehub_find_package_licenses(gccLicenses ROOTS ${compilerRoots} PACKAGES gcc-libs)
        gamehub_install_component_licenses(gcc-runtime ${gccLicenses})
        gamehub_find_package_licenses(crtLicenses ROOTS ${compilerRoots} PACKAGES crt)
        gamehub_install_component_licenses(mingw-runtime ${crtLicenses})
        gamehub_find_package_licenses(pthreadLicenses ROOTS ${compilerRoots} PACKAGES libwinpthread winpthreads)
        gamehub_install_component_licenses(winpthreads ${pthreadLicenses})
    endif()
endfunction()

# 生成安装清单并注册安装后的完整性检查；参数无，无返回值。
function(gamehub_write_license_manifest)
    get_property(manifest GLOBAL PROPERTY GAMEHUB_LICENSE_MANIFEST)
    string(JOIN "" manifest ${manifest})
    set(manifestFile "${CMAKE_BINARY_DIR}/gamehub-licenses/manifest.tsv")
    file(WRITE "${manifestFile}" "component\tfile\tsha256\n${manifest}")
    install(FILES "${manifestFile}" DESTINATION share/gamehub/licenses)
    get_property(GAMEHUB_LICENSE_RECORDS GLOBAL PROPERTY GAMEHUB_LICENSE_RECORDS)
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/VerifyInstalledLicenses.cmake.in"
        "${CMAKE_BINARY_DIR}/gamehub-licenses/verify.cmake" @ONLY)
    # 安装完成后核对摘要，即使配置后原始许可被清空也不能报告安装成功。
    install(SCRIPT "${CMAKE_BINARY_DIR}/gamehub-licenses/verify.cmake")
endfunction()
