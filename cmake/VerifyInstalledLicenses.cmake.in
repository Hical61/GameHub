set(records "@GAMEHUB_LICENSE_RECORDS@")
foreach(record IN LISTS records)
    string(REPLACE "|" ";" fields "${record}")
    list(GET fields 0 relative)
    list(GET fields 1 expected)
    list(GET fields 2 source)
    if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
        message(FATAL_ERROR "原始许可不存在：${relative}，请重新配置并检查依赖许可。")
    endif()
    # 文件安装可能因时间戳相同而跳过复制，不能只检查安装目录里的旧副本。
    file(SHA256 "${source}" sourceHash)
    if(NOT sourceHash STREQUAL expected)
        message(FATAL_ERROR "原始许可与配置时的文件不一致：${relative}，请重新配置并检查依赖许可。")
    endif()
    set(path "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/share/gamehub/licenses/${relative}")
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "安装目录缺少许可：${relative}")
    endif()
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "安装许可与配置时的原始文件不一致：${relative}，请重新配置并检查依赖许可。")
    endif()
endforeach()
