root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{h,cpp,hpp,c}]
# 与 clang-format 的 ForContinuationAndIndentation 保持一致。
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 120

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[CMakeLists.txt]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
