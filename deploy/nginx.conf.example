# 把下面两个 server 放进 nginx 的 http 配置，再改成实际域名、证书和 Hub 地址。
# 公网只转发回调路径，管理和配置接口留给内网。
server {
    listen 443 ssl;
    server_name callbacks.example.invalid;
    ssl_certificate     /etc/nginx/tls/callbacks.crt;
    ssl_certificate_key /etc/nginx/tls/callbacks.key;
    client_max_body_size 64k;
    client_body_timeout 5s;
    location /api/callback/ {
        proxy_pass http://127.0.0.1:8443;
        proxy_connect_timeout 1s;
        proxy_read_timeout 4s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location / { return 404; }
}

server {
    listen 127.0.0.1:8081;
    server_name localhost;
    client_max_body_size 64k;
    allow 127.0.0.1;
    deny all;
    location /admin/ { proxy_pass http://127.0.0.1:8443; }
    location /internal/config/ { proxy_pass http://127.0.0.1:8443; }
    location / { return 404; }
}
